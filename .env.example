# Copy to .env.local for development, or set these in your static host's build settings.
# Supabase project URL and PUBLIC publishable key (a legacy anon key also works).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Never put a service_role key, secret key, device token, or Telegram token here.
# Anything prefixed VITE_ is included in the browser's public JavaScript bundle.
