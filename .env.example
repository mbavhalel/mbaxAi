# Copy to .env on the cloud VM. Never commit the completed file.
# Point this hostname at the VM's public IP (no https:// prefix).
DOMAIN=your-storeroom.duckdns.org
APP_USERNAME=admin
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
APP_PASSWORD=

# Your ESP32 and this server must use the SAME reachable broker.
MQTT_HOST=
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=storeroom-server

# Optional: send alerts directly from the server using an existing Telegram bot.
TG_TOKEN=
TG_CHAT_ID=
